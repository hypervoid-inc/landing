{
  "name": "landing-next",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm generate:content && react-router build && node scripts/finalize-build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm check && pnpm test:e2e && pnpm build && wrangler pages deploy build/client --project-name landing-new --branch main",
    "dev": "react-router dev --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:content": "node scripts/generate-content.mjs",
    "lint": "eslint .",
    "og": "node scripts/generate-og.mjs",
    "og:generate": "node scripts/generate-art.mjs",
    "og:pick": "node scripts/generate-art.mjs --pick",
    "og:prompts": "node scripts/generate-og.mjs --prompts",
    "retheme": "node scripts/retheme-asset.mjs",
    "preview": "wrangler pages dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@marsidev/react-turnstile": "^1.5.3",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^1.24.0",
    "posthog-js": "^1.407.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.68.0"
  }
}
