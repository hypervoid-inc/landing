# Local landing Pages secret for Construct API newsletter ingest (optional).
# SIGNUP_INGEST_SECRET=
# Listmonk private API (enables subscriber attribs + campaign-touch). Pair with API token secret.
# LISTMONK_API_USER=
# LISTMONK_API_TOKEN=
# Optional numeric list id (skips UUID→id lookup). LISTMONK_NEWSLETTER_LIST_ID=
# Server PostHog for POST /api/campaign-touch (Pages secret in production).
# POSTHOG_PROJECT_KEY=
# POSTHOG_HOST=https://x.construct.computer
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://x.construct.computer"
# Local dev: point at the API running on :9001 (`pnpm --filter api dev` in ../v2).
# construct_session is host-only and SameSite=Lax, so localhost:5173 ->
# api.construct.computer is cross-site and the browser drops the cookie —
# SSO with the OS silently fails against the deployed API.
VITE_API_ORIGIN="http://localhost:9001"
VITE_OS_ORIGIN="http://localhost:9000"
GEMINI_API_KEY=""
