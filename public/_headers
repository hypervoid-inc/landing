/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://x.construct.computer https://join.construct.computer; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.googleusercontent.com; media-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://x.construct.computer wss://x.construct.computer https://api.construct.computer https://join.construct.computer; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; upgrade-insecure-requests
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=600, stale-while-revalidate=86400

/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/landing/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap.xml
  Cache-Control: public, max-age=300, must-revalidate

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate

# RFC 8288 Link headers on the homepage: an agent that fetches one page learns
# where the machine-readable descriptions are without guessing at well-known
# paths, and without parsing HTML. RFC 9727 section 3 defines api-catalog.
# Scoped to `/` rather than `/*` on purpose. Pages matches paths, not content
# types, so `/*` would hang four Link headers off every image and script too.
/
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </openapi.json>; rel="service-desc"; type="application/json"
  Link: </docs/api/>; rel="service-doc"; type="text/html"
  Link: </llms.txt>; rel="describedby"; type="text/plain"

# RFC 9727 requires the catalog be served as application/linkset+json. The file
# is extensionless, so Cloudflare cannot infer that. CORS is open on the
# discovery documents because that is the whole point of publishing them.
# No Cache-Control here on purpose: Pages appends rather than replaces, and a
# second directive set would only make the header ambiguous. The `/*` rule
# already caches these correctly.
/.well-known/api-catalog
  Access-Control-Allow-Origin: *
  Content-Type: application/linkset+json

/openapi.json
  Access-Control-Allow-Origin: *

https://construct-landing.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.construct-landing.pages.dev/*
  X-Robots-Tag: noindex, nofollow
