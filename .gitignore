.DS_Store
.env*
!.env.example
.dev.vars*
/node_modules/
*.key
*.pem

# React Router
/.react-router/
/build/
.wrangler/
playwright-report/
test-results/

# Unpromoted style plates, the undo copies `pnpm og:fix` leaves behind, and a
# local record of what generation cost.
# `assets/og/poster/candidates/` is deliberately NOT ignored: the alternates
# kept there are worth having, and generating them again costs money.
/assets/og/style/master-*.webp
*.before.webp
/assets/og/generation-log.jsonl

# Cards rendered by `pnpm og:sheet` for review.
/assets/og/check/

# Plain-Markdown copies of posts written by `pnpm blog:text`, rebuilt on demand.
/syndication/

# Feeds, sitemap and llms text written into `public/` by `pnpm generate:content`
# on every build.
/public/sitemap.xml
/public/rss.xml
/public/atom.xml
/public/feeds/full-text.xml
/public/llms.txt
/public/llms-full.txt
