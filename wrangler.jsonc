{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landing-new",
  "pages_build_output_dir": "./build/client",
  "compatibility_date": "2026-07-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "construct-landing",
      "database_id": "c108070e-5e0e-40c6-96e5-01a4d8777df6",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "TURNSTILE_EXPECTED_HOSTNAME": "construct.computer",
    "TURNSTILE_EXPECTED_ACTION": "beta_signup",
    "TURNSTILE_TEST_MODE": "false",
    "ALLOWED_ORIGIN_HOSTNAME": "construct.computer",
    "LISTMONK_BASE_URL": "https://listmonk.construct.computer",
    "LISTMONK_NEWSLETTER_LIST_UUID": "7c3e7b8c-7e05-4482-a5eb-a20c7505dbf6",
    // Handed out by the exit offer for an email: 100% off the first month of
    // Pro. Create the matching coupon in Dodo before the demo goes live.
    "EMBED_PROMO_CODE": "FREEMONTH",
    // The claim email goes out through Cloudflare Email Service's REST API
    // (functions/claim-email.ts) with the EMAIL_API_TOKEN secret.
    "CLOUDFLARE_ACCOUNT_ID": "5d7aa603ebe193d63efb09a759c0c3ed",
    // A mailbox that takes replies: noreply senders read as bulk mail.
    "EMBED_EMAIL_FROM": "hello@construct.computer",
    "EMBED_EMAIL_FROM_NAME": "Construct Computer",
    "EMBED_EMAIL_REPLY_TO": "hello@construct.computer",
  },
}
